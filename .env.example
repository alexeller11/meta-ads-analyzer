# ── META / FACEBOOK ──────────────────────────────────────────────────────────
FB_APP_ID=cole_o_id_do_app_aqui
FB_APP_SECRET=cole_a_chave_secreta_aqui

# ── SERVIDOR ─────────────────────────────────────────────────────────────────
BASE_URL=https://seu-dominio.up.railway.app
SESSION_SECRET=troque-por-qualquer-frase-longa-aqui-2024
PORT=3000
NODE_ENV=production

# ── BANCO DE DADOS (Neon.tech ou outro PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://neondb_owner:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── IA: MOTOR PRINCIPAL (NVIDIA ou OpenAI) ──────────────────────────────────
# Se NVIDIA_API_KEY estiver presente, ela será usada como motor principal.
NVIDIA_API_KEY=nvapi-xxxx
AI_MODEL=meta/llama-3.1-405b-instruct

# OpenAI (Opcional se usar NVIDIA)
OPENAI_API_KEY=sk-...

# ── ALERTAS DE E-MAIL (opcional — para alertas de saldo baixo) ───────────────
ALERT_EMAIL_USER=seu@gmail.com
ALERT_EMAIL_PASS=sua-senha-de-app-gmail
ALERT_EMAIL_TO=destinatario@email.com
